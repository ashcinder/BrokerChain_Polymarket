<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_row_opt_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Option Name"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_row_opt_shares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="持有 0 份"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_row_prob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="0%"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_row_buy_yes"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:paddingHorizontal="12dp"
                android:text="Yes"
                android:textAllCaps="false"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#E6F4EA"
                app:cornerRadius="8dp"
                app:strokeColor="#A7F3D0"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_row_buy_no"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:paddingHorizontal="12dp"
                android:text="No"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="8dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/view_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="#E2E8F0" />

</LinearLayout>